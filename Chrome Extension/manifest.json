{
    "manifest_version": 3,
    "name": "Leads Tracker",
    "version": "1.0",
    "description": "Tracks and manages your business leads.",
    "action": {
        "default_popup": "index.html",
        "default_icon": "icon.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "leads-tracker-scrimba-bootcamp-@yourdomain.com",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    }
}